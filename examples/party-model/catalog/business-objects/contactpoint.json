{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.internal/dq/schemas/contactpoint/1.0.0",
  "title": "Contact point",
  "description": "A party's contact points, modelled on ISO 19160-4 address components. The address is a postal address, not a free-text line: a free-text line cannot be validated against a country's postcode grammar, which is what SEM-CPT-001 needs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["partyId", "contacts"],
  "properties": {
    "partyId": {
      "type": "string",
      "pattern": "^PTY-[0-9]{8}$"
    },
    "contacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/contact" }
    }
  },
  "$defs": {
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "address"],
      "properties": {
        "type": { "$ref": "https://registry.internal/dq/valuesets/contact-point-type" },
        "address": { "$ref": "#/$defs/postalAddress" }
      }
    },
    "postalAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["street1", "city", "postalCode", "country"],
      "properties": {
        "street1": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Thoroughfare and building number, as printed."
        },
        "street2": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "administrativeArea": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "State, province or county. Required for US and CA by SEM-CPT-002."
        },
        "postalCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16,
          "description": "Stored untransformed; the country's grammar is checked by SEM-CPT-001, not by a pattern here, because a pattern would have to know the country."
        },
        "country": { "$ref": "https://registry.internal/dq/valuesets/country-code-iso3166-1" }
      }
    }
  }
}
